{
  "name": "crashoria-ultimate-road-adventure",
  "version": "3.2.0",
  "description": "Crashoria: Ultimate Road Adventure - BeamNG Soft-Body Physics Edition v3.2.0 - 車載GPSカーナビゲーション・警察ON/OFF機能＆危険運転時のみ出動・新規10車種追加（計18車種）・新規10マップ追加（計16マップ）・マップ専用新ギミック（水たまりスリップ・レーザーゲート・マグマ地割れ・朱色鳥居ゲート・シケインバリア）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder --win portable nsis"
  },
  "author": "youyouboydragonOfficial",
  "license": "MIT",
  "build": {
    "appId": "com.crashoria.ultimate.road.adventure",
    "productName": "CrashoriaUltimateRoadAdventure",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Crashoria-Ultimate-Road-Adventure-Setup-v3.2.0.exe"
    },
    "portable": {
      "artifactName": "Crashoria-Ultimate-Road-Adventure-Portable-v3.2.0.exe"
    }
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  }
}
