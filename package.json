{
  "name": "crashoria-ultimate-road-adventure",
  "version": "3.5.1",
  "description": "Crashoria: Ultimate Road Adventure - BeamNG Soft-Body Physics Edition v3.5.1 - Attachment 3D Visualizer & Background Zombie Audio Fix",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder --win portable nsis"
  },
  "author": "youyouboydragonOfficial",
  "license": "MIT",
  "build": {
    "appId": "com.crashoria.ultimate.road.adventure",
    "productName": "CrashoriaUltimateRoadAdventure",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Crashoria Ultimate Road Adventure",
      "artifactName": "Crashoria-Ultimate-Road-Adventure-Setup-v3.5.1.exe"
    },
    "portable": {
      "artifactName": "Crashoria-Ultimate-Road-Adventure-Portable-v3.5.1.exe"
    }
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  }
}
