{
  "name": "crashoria-ultimate-road-adventure",
  "version": "3.1.0",
  "description": "Crashoria: Ultimate Road Adventure - BeamNG Soft-Body Physics Edition v3.1.0 - 警察追跡バランス刷新＆トラップ撃破（ドラム缶・落石・スパイク破壊可能）・逃走メーター・パッシング目眩まし・ハザード緊急エアブレーキ＆リア防壁カウンター・ドリフトミニターボ加速",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder --win portable nsis"
  },
  "author": "youyouboydragonOfficial",
  "license": "MIT",
  "build": {
    "appId": "com.crashoria.ultimate.road.adventure",
    "productName": "CrashoriaUltimateRoadAdventure",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Crashoria-Ultimate-Road-Adventure-Setup-v3.1.0.exe"
    },
    "portable": {
      "artifactName": "Crashoria-Ultimate-Road-Adventure-Portable-v3.1.0.exe"
    }
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  }
}
