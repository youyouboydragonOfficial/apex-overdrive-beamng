{
  "name": "apex-overdrive-beamng",
  "version": "2.8.0",
  "description": "APEX OVERDRIVE: BeamNG Soft-Body Physics Edition v2.8 - v2.0安定復元ベース・パッシング完全回避・非ブレ固定HUD・迫力Synthwave音響・ターボ過給圧計＆ブローオフバルブ・天候切替 Windows App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder --win portable nsis"
  },
  "author": "youyouboydragonOfficial",
  "license": "MIT",
  "build": {
    "appId": "com.apexoverdrive.beamng.edition",
    "productName": "ApexOverdriveBeamNG",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "ApexOverdrive-BeamNG-Setup-v2.8.0.exe"
    },
    "portable": {
      "artifactName": "ApexOverdrive-BeamNG-Portable-v2.8.0.exe"
    }
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  }
}
