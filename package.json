{
  "name": "crashoria-ultimate-road-adventure",
  "version": "3.0.0",
  "description": "Crashoria: Ultimate Road Adventure - BeamNG Soft-Body Physics Edition v3.0 - 全6マップ固有ギミック（首都高オービス・巨石崩落・ブラックアイス・高圧火柱・超電導加速・展望メガジャンプ）・バウンティ指令・スリップストリーム・パワードリフト・警察追跡・キルカメラ Windows App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder --win portable nsis"
  },
  "author": "youyouboydragonOfficial",
  "license": "MIT",
  "build": {
    "appId": "com.crashoria.ultimate.road.adventure",
    "productName": "CrashoriaUltimateRoadAdventure",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Crashoria-Ultimate-Road-Adventure-Setup-v3.0.0.exe"
    },
    "portable": {
      "artifactName": "Crashoria-Ultimate-Road-Adventure-Portable-v3.0.0.exe"
    }
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  }
}