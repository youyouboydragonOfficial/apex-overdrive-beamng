{
  "name": "apex-overdrive-beamng",
  "version": "2.9.0",
  "description": "APEX OVERDRIVE: BeamNG Soft-Body Physics Edition v2.9 - 大型トラック荷崩れ物理（丸太転がり大ダメージ＆土砂流出バンパー破損・急減速）・新マップ（首都高C1＆箱根紅葉）・新車（930 TURBO GT＆HELLCAT V8）・視界クリア左上通知HUD Windows App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder --win portable nsis"
  },
  "author": "youyouboydragonOfficial",
  "license": "MIT",
  "build": {
    "appId": "com.apexoverdrive.beamng.edition",
    "productName": "ApexOverdriveBeamNG",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "ApexOverdrive-BeamNG-Setup-v2.9.0.exe"
    },
    "portable": {
      "artifactName": "ApexOverdrive-BeamNG-Portable-v2.9.0.exe"
    }
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  }
}